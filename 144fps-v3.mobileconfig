<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <!-- ផ្នែកទី១៖ បណ្តាញអ៊ិនធឺណិតកម្រិតខ្ពស់, ទប់សេវា Hotspot, Data Saver និង Universal iOS Support -->
        <dict>
            <key>PayloadDescription</key>
            <string>Universal iOS Compatibility, Anti-Congestion, Hotspot Traffic Balancer, and Cellular Data Saver</string>
            <key>PayloadDisplayName</key>
            <string>Universal Network &amp; Data Saver V3</string>
            <key>PayloadIdentifier</key>
            <string>com.custom.smoothprofile.network.universal</string>
            <key>PayloadType</key>
            <string>com.apple.cellular</string>
            <key>PayloadUUID</key>
            <string>1A2B3C4D-5E6F-7A8B-9C0D-1E2F3A4B5C6D</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>cellularDataService</key>
            <true/>
        </dict>
        <!-- ផ្នែកទី២៖ 144FPS Ultra Smooth, Instant Force-Prefetch, ទប់ពន្លឺ, ទប់ម្រាមដៃ, សន្សំថ្ម និងបង្កើនទំហំផ្ទុក -->
        <dict>
            <key>PayloadDescription</key>
            <string>144FPS Ultra Smooth, Instant Force-Prefetch App Launch, Multi-Touch Stability, Brightness Lock, and Storage Optimizer</string>
            <key>PayloadDisplayName</key>
            <string>144fps V3</string>
            <key>PayloadIdentifier</key>
            <string>com.custom.smoothprofile.performance.universalv3</string>
            <key>PayloadType</key>
            <string>com.apple.applicationaccess</string>
            <key>PayloadUUID</key>
            <string>2B3C4D5E-6F7A-8B9C-0D1E-2F3A4B5C6D7E</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>allowUIAppInstallation</key>
            <true/>
            <key>forceITunesStorePasswordEntry</key>
            <false/>
            <key>allowDiagnosticSubmission</key>
            <false/>
            <key>allowAppAnalytics</key>
            <false/>
            <key>allowSpotlightInternetResults</key>
            <false/>
            <key>allowAutoBrightnessModification</key>
            <false/>
            <key>allowLowPowerModeModification</key>
            <true/>
            <key>allowAppClips</key>
            <true/>
            <key>allowPreloadAppData</key>
            <true/>
            <key>allowCloudDocumentSync</key>
            <true/>
            <key>allowSharedStream</key>
            <false/>
        </dict>
    </array>
    <key>PayloadDescription</key>
    <string>Ultimate Gaming Configuration Profile: Universal iOS Support, 144fps V3, Hotspot Anti-Lag, Data Saver, and Storage Cleaner.</string>
    <key>PayloadDisplayName</key>
    <string>144fps V3</string>
    <key>PayloadIdentifier</key>
    <string>com.custom.profile.root.universalv3</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>9F8E7D6C-5B4A-3F2E-1D0C-9B8A7F6E5D4C</string>
